# Entwicklung. Als .env kopieren und Secrets ersetzen (oder ./setup.sh nutzen).
APP_ENV=development
SECRET_KEY=hier-einen-langen-zufaelligen-wert-eintragen
APP_PORT=8100
APP_UID=1000
APP_GID=1000

# MariaDB
MARIADB_DATABASE=tanban_cursor
MARIADB_USER=tanban_cursor
MARIADB_PASSWORD=hier-ein-langes-datenbankpasswort-eintragen
MARIADB_ROOT_PASSWORD=hier-ein-anderes-root-passwort-eintragen

# TanBan (Outbound-API + eingehende Webhooks)
TANBAN_BASE_URL=http://host.docker.internal:8000
TANBAN_API_KEY=tbk_hier-board-api-key-eintragen
# Numeric board id (needed to resolve current card labels via API)
TANBAN_BOARD_ID=
# Signing-Secret aus webhook-create (tbwh_…); leer = Signaturprüfung aus (nur Dev)
TANBAN_WEBHOOK_SECRET=

# Cursor (API-Key aus Cursor Dashboard)
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# cloud | local — Dispatch sendet immer cloud
CURSOR_RUNTIME=cloud
# GitHub/GitLab repo URL for cloud agents, e.g. https://github.com/org/repo
CURSOR_REPOSITORY=
