# Entwicklung. Als .env kopieren und Secrets ersetzen (oder ./setup.sh nutzen).
APP_ENV=development
SECRET_KEY=hier-einen-langen-zufaelligen-wert-eintragen
APP_PORT=8100
APP_UID=1000
APP_GID=1000

# MariaDB
MARIADB_DATABASE=tanban_cursor
MARIADB_USER=tanban_cursor
MARIADB_PASSWORD=hier-ein-langes-datenbankpasswort-eintragen
MARIADB_ROOT_PASSWORD=hier-ein-anderes-root-passwort-eintragen

# TanBan
# Im Docker-Shared-Netz (tanban-shared): Service-Hostname, z.B. http://tanban-app-1:8000
# host.docker.internal greift nicht, wenn TanBan nur auf 127.0.0.1 publiziert ist.
TANBAN_BASE_URL=http://tanban-app-1:8000

# Multi-Board (empfohlen): JSON-Map board.public_id → Credentials.
# Jedes Board braucht eigenen Board-API-Key (tbk_…) und Webhook-Secret (tbwh_…).
# Einzeilig halten (Compose/dotenv).
# TANBAN_BOARDS={"7da2efd2-…":{"board_id":4,"api_key":"tbk_…","webhook_secret":"tbwh_…"},"0ad3b7e1-…":{"board_id":3,"api_key":"tbk_…","webhook_secret":"tbwh_…"}}

# Legacy Einzelboard (wenn TANBAN_BOARDS leer):
TANBAN_API_KEY=tbk_hier-board-api-key-eintragen
TANBAN_BOARD_ID=
# public_id des Boards (Webhook-Payload board.public_id) — macht Legacy zum 1-Board-Map-Eintrag
TANBAN_BOARD_PUBLIC_ID=
# Signing-Secret aus webhook-create (tbwh_…); leer = Signaturprüfung aus (nur Dev)
TANBAN_WEBHOOK_SECRET=

# Cursor (API-Key aus Cursor Dashboard)
# true = scharf (weiterleiten); false = nur loggen (Debug)
CURSOR_ACTIVE=false
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# cloud | local — Dispatch sendet immer cloud
CURSOR_RUNTIME=cloud
# GitHub/GitLab repo URL for cloud agents, e.g. https://github.com/org/repo
CURSOR_REPOSITORY=
